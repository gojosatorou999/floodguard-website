# Copy this file to .env.local (which is already gitignored) and fill
# in your Supabase project's values: Dashboard → Project Settings → API.
# Both are safe to expose in client-side code — the anon key only grants
# what your Row Level Security policies (see supabase/schema.sql) allow.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google sign-in — the OAuth *Web* client ID from Google Cloud Console
# (see the notes at the bottom of supabase/schema.sql). Public, like the
# two values above. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Production also needs the project ref in vercel.json's /sb rewrite.
