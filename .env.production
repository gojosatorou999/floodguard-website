# Public client config, read by Vite for production builds (npm run build).
# Every value here ends up in the JavaScript sent to visitors — that's
# intended: the publishable key only grants what Row Level Security in
# supabase/schema.sql allows, and the Google client ID only works on the
# origins listed in Google Cloud Console.
#
# NEVER put a secret here (Supabase sb_secret_/service_role key, Google
# client secret, database password). Those belong in the host's private
# env vars without the VITE_ prefix, read only by server-side code.

VITE_SUPABASE_URL=https://lywnmsbsnumjahvtflmq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_x1PvH5jNigqGPiREUZAHWQ_sqtLZNZi
VITE_GOOGLE_CLIENT_ID=997526266369-460gujt2lusvl6dqpn7qu28dsba0u2ge.apps.googleusercontent.com
